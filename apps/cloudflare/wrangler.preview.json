{
  "account_id": "b3917d63f5b0f7e77219956e3ee92bce",
  "name": "acornary-cf-preview",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "acornary-cf-preview-auth",
      "database_id": "c61d4fc5-d759-468a-b0c9-cf6e155cdf9e",
      "migrations_dir": "migrations/auth"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "acornary-cf-preview-blobs"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "acornary-cf-preview-backups"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "acornary-cf-preview-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "acornary-cf-preview-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "acornary-cf-preview-failed"
      }
    ]
  },
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cf.acornary.protium.top",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOUSEHOLDS",
        "class_name": "HouseholdStore"
      },
      {
        "name": "UPLOADS",
        "class_name": "AttachmentUpload"
      }
    ]
  },
  "migrations": [
    {
      "tag": "native-v1",
      "new_sqlite_classes": ["HouseholdStore"]
    },
    {
      "tag": "native-v2-uploads",
      "new_sqlite_classes": ["AttachmentUpload"]
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/.well-known/*",
      "/health",
      "/android/oauth/callback",
      "/api",
      "/.well-known"
    ]
  },
  "vars": {
    "ORIGIN": "https://cf.acornary.protium.top",
    "ENVIRONMENT": "preview",
    "RELEASE_VERSION": "development",
    "RELEASE_COMMIT": "development",
    "TERMINAL_CLIENT_ID": "acornary-cf-preview-android-v1",
    "TERMINAL_SIGNING_FINGERPRINTS": "DD:FF:D0:88:78:90:C2:82:A9:2E:AC:A0:37:F9:CD:60:CC:66:1D:F4:B4:E3:98:AA:1B:2A:A1:A0:39:E6:4C:EC"
  },
  "triggers": {
    "crons": ["17 19 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
