{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "../../../tests/web",
    "vite.config.ts",
    "vite.plugin.config.ts",
    "review",
    ".storybook",
    "vite.candidate.config.ts"
  ]
}
