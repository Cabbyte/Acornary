{
  "name": "acornary",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json && pnpm cf:typecheck",
    "build": "pnpm cf:build && wrangler deploy --dry-run --config apps/cloudflare/wrangler.preview.json --outdir ../../output/cloudflare-preview",
    "start": "node scripts/cloudflare/dev.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm cf:test:browser",
    "cf:contracts": "tsx scripts/cloudflare/contracts.ts",
    "cf:test:kernel": "wrangler deploy --dry-run --config tests/cloudflare/wrangler.jsonc --outdir ../../output/cloudflare-test && node --import tsx --test tests/cloudflare/kernel.test.mjs",
    "cf:typecheck": "tsc -p apps/cloudflare/tsconfig.json",
    "cf:auth-schema": "tsx scripts/cloudflare/auth-schema.ts",
    "cf:snapshot": "tsx scripts/cloudflare/snapshot.ts",
    "cf:import-auth": "node --import tsx scripts/cloudflare/import-auth.mjs",
    "cf:import-blobs": "node --import tsx scripts/cloudflare/import-blobs.mjs",
    "cf:check:auth-remote": "node --import tsx scripts/cloudflare/check-auth-import-remote.mjs",
    "cf:check:blobs-remote": "node --import tsx scripts/cloudflare/check-blobs-remote.mjs",
    "cf:test:snapshot": "wrangler deploy --dry-run --config tests/cloudflare/wrangler.inventory.jsonc --outdir ../../output/cloudflare-inventory && node --import tsx --test tests/cloudflare/snapshot.test.mjs",
    "cf:test:inventory": "wrangler deploy --dry-run --config tests/cloudflare/wrangler.inventory.jsonc --outdir ../../output/cloudflare-inventory && node --test tests/cloudflare/inventory.test.mjs",
    "cf:test:auth": "node --import tsx --test tests/cloudflare/auth-commands.test.mjs",
    "cf:test:http": "wrangler deploy --dry-run --config tests/cloudflare/wrangler.auth.jsonc --outdir ../../output/cloudflare-auth && node --test tests/cloudflare/auth-http.test.mjs",
    "cf:import-households": "node --import tsx scripts/cloudflare/import-households.mjs",
    "cf:test:backup": "wrangler deploy --dry-run --config tests/cloudflare/wrangler.backup.jsonc --outdir ../../output/cloudflare-backup && node --test tests/cloudflare/backup.test.mjs",
    "cf:build": "node scripts/cloudflare/build-assets.mjs --environment preview",
    "cf:dry-run": "pnpm cf:build && wrangler deploy --dry-run --config apps/cloudflare/wrangler.preview.json --outdir ../../output/cloudflare-preview",
    "cf:backup": "node scripts/cloudflare/backup.mjs",
    "cf:release:check": "node --import tsx scripts/cloudflare/release.mjs",
    "cf:deploy:preview": "node --import tsx scripts/cloudflare/release.mjs --deploy",
    "cf:test:browser": "pnpm cf:build && wrangler deploy --dry-run --config apps/cloudflare/wrangler.preview.json --outdir ../../output/cloudflare-browser && node scripts/cloudflare/browser.mjs",
    "cf:reference": "node scripts/cloudflare/reference.mjs",
    "cf:test:operators": "node --test tests/cloudflare/operators.test.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry -c apps/web/.storybook",
    "build:storybook": "storybook build --disable-telemetry -c apps/web/.storybook -o output/storybook",
    "dev:ui-preview": "vite --config apps/web/review/vite.config.ts",
    "build:ui-preview": "vite build --config apps/web/review/vite.config.ts",
    "generate:ui-tokens": "node scripts/ui/tokens.mjs",
    "check:ui-tokens": "node scripts/ui/tokens.mjs --check",
    "check:ui-boundaries": "node scripts/ui/boundaries.mjs",
    "test:e2e:ui": "playwright test --config apps/web/review/playwright.config.ts",
    "check:ui-catalog": "node scripts/ui/catalog.mjs",
    "dev:ui-trial": "vite --config apps/web/review/trial/vite.config.ts",
    "build:ui-trial": "vite build --config apps/web/review/trial/vite.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@better-auth/cimd": "1.7.5",
    "@better-auth/core": "1.7.5",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@mmote/niimbluelib": "0.47.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "antd": "6.6.5",
    "better-auth": "1.7.5",
    "dayjs": "1.11.23",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.65.0",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5",
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "react-day-picker": "10.0.2",
    "react-hook-form": "7.91.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "5.20261103.0-beta",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.157.0",
    "pg": "^8.23.0",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.4",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.4"
  }
}
